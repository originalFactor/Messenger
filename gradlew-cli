#
# Runs the Gradle wrapper with its OWN daemon registry.
#
# Why: a warm daemon is worth ~4 s per invocation (JVM start + configuration),
# but sharing the default registry with Android Studio is what made CLI builds
# deadlock against the IDE's busy daemon — the reason AGENTS.md used to require
# `--no-daemon` everywhere. A separate registry gives the CLI its own daemon and
# leaves the IDE's untouched; the Gradle user home caches stay shared (Gradle
# locks them across daemons).
#
# Usage: ./gradlew-cli :androidApp:assembleDebug
# Override the registry location with GRADLE_CLI_REGISTRY if needed.

DIR=$(cd "$(dirname "$0")" && pwd)
GRADLE_OPTS="-Dorg.gradle.daemon.registry.base=${GRADLE_CLI_REGISTRY:-$HOME/.gradle/cli-daemon} $GRADLE_OPTS"
export GRADLE_OPTS
exec "$DIR/gradlew" --daemon "$@"
