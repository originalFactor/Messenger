Screen { background: $background; color: $text; align-horizontal: center; }
#workspace { width: 100%; max-width: 96; height: 1fr; padding: 1 2 0 2; }
#heading { height: 2; text-overflow: ellipsis; }
#model { height: 1; color: $text-muted; text-overflow: ellipsis; padding-left: 2; }
#history { height: 1fr; padding: 1 0; scrollbar-size: 1 1; }
#transcript { height: auto; }
#suggestions { height: auto; max-height: 5; border: none; padding: 0 1; background: $surface; }
#input-row { height: 3; padding: 1 1; background: $surface; }
#prompt { width: 2; height: 1; text-style: bold; color: $text; background: $surface; }
#composer { height: 1; min-height: 1; border: none; padding: 0; background: $surface; }
#composer:focus { border: none; }
#composer.busy { color: $text-muted; }
#status, #keys { height: 1; text-overflow: ellipsis; }
#status { color: $text-muted; }
#status.error { color: $error; text-style: bold; }
#keys { color: $text-muted; }
Screen.compact #workspace { padding: 0 1; }
Screen.compact #heading { height: 1; }
Screen.compact #history { padding: 0; }
#size-warning { display: none; height: 1fr; content-align: center middle; padding: 1; }
Screen.too-small #workspace { display: none; }
Screen.too-small #size-warning { display: block; }
Dialog { padding: 0; align: center middle; background: $background 90%; }
Dialog > Vertical {
    width: 76; max-width: 96%; height: auto; max-height: 95%;
    border: none; padding: 1 2; background: $surface; overflow-y: auto;
}
Dialog Label, Dialog Static { height: auto; }
Dialog .dialog-title { color: $text; text-style: bold; margin-bottom: 1; }
Dialog Input { border: none; height: 1; padding: 0 1; margin-bottom: 1; background: $background; }
Dialog Input:focus { border: none; border-left: solid $accent; padding-left: 0; background: $panel; }
Dialog Button { min-width: 12; height: 1; min-height: 1; border: none; background: transparent; color: $text-muted; margin: 1 0; }
Dialog Button.-primary, Dialog Button.-error { background: transparent; }
Dialog Button.-primary { color: $text; text-style: bold; }
Dialog Button.-error { color: $error; }
Dialog Button:focus { text-style: bold underline; color: $text; background: $panel; border: none; }
Dialog Checkbox:focus { text-style: bold underline; }
Dialog .dialog-keys { color: $text-muted; height: auto; margin-top: 1; }
Dialog OptionList { border: none; padding: 0; background: $surface; scrollbar-size: 1 1; }
OptionList > .option-list--option-highlighted { text-style: bold; background: $panel; color: $text; }
Dialog .action-row { height: auto; }
Dialog.narrow .action-row { layout: vertical; }
Dialog.narrow .action-row Button { width: 100%; }
Dialog.narrow > Vertical { padding: 0 1; max-height: 100%; }
ProviderEditor > Vertical { height: auto; }
#provider-fields { height: auto; max-height: 55vh; }
